{
  "name": "eslint.org",
  "private": true,
  "version": "1.0.0",
  "description": "The codebase for the ESLint website (eslint.org)",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "repository": "eslint/eslint.org",
  "funding": "https://opencollective.com/eslint",
  "bugs": "https://github.com/eslint/eslint.org/issues/",
  "engines": {
    "node": ">= 24"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm-run-all build:website build:minify-images",
    "build:init-blog-dates": "node tools/update-blog-dates.js --init",
    "build:minify-images": "imagemin 'dist/assets/images' --out-dir='dist/assets/images'",
    "build:minify-svg": "svgo -r -f ./",
    "build:sponsors": "node tools/generate-sponsors.js",
    "build:website": "astro build",
    "dev": "astro dev",
    "fetch": "npm-run-all --parallel fetch:*",
    "fetch:stats": "node tools/fetch-stats.js",
    "fetch:sponsors": "node tools/fetch-sponsors.js",
    "fetch:team": "node tools/fetch-team-data.js",
    "lint": "npm-run-all --parallel lint:js lint:md lint:scss",
    "lint:fix": "npm-run-all --parallel lint:fix:*",
    "lint:js": "eslint .",
    "lint:fix:js": "eslint . --fix",
    "lint:links": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node tools/validate-links.js",
    "lint:md": "markdownlint \"**/*.md\" ",
    "lint:fix:md": "markdownlint --fix  \"**/*.md\"",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:fix:scss": "stylelint \"**/*.scss\" --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "lint-staged": {
    "**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint \"**/*.scss\" --fix",
      "prettier --write"
    ],
    "*.json": "prettier --write",
    "*.md": "markdownlint --fix",
    "src/content/blog/*.md": [
      "node tools/update-blog-dates.js",
      "git add src/data/blog-dates.json"
    ],
    "**/*.svg": "npx svgo -r --multipass"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@munter/tap-render": "^0.2.0",
    "@octokit/graphql": "^4.8.0",
    "@octokit/rest": "^18.12.0",
    "@types/node": "^24.19.2",
    "astro": "^7.4.12",
    "cheerio": "*",
    "common-tags": "^1.8.2",
    "cross-env": "^7.0.3",
    "download-stats": "^0.3.4",
    "eslint": "^10.15.0",
    "eslint-config-eslint": "^14.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "gray-matter": "^4.0.3",
    "hyperlink": "^5.0.4",
    "imagemin": "^8.0.1",
    "imagemin-cli": "^7.0.0",
    "js-yaml": "^5.5.0",
    "lint-staged": "^13.3.0",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.3",
    "markdown-it-anchor": "^9.2.1",
    "markdownlint-cli": "^0.50.0",
    "node-stdlib-browser": "^1.3.1",
    "npm-run-all2": "^8.0.4",
    "oxc-transform-react": "^0.156.0",
    "prettier": "3.10.1",
    "prismjs": "^1.30.0",
    "sass": "^1.108.2",
    "semver": "^7.8.6",
    "slugify": "^1.6.9",
    "stylelint": "^14.16.1",
    "stylelint-config-standard-scss": "^5.0.0",
    "tap-spot": "^1.1.2",
    "typescript": "^5.9.3",
    "undici": "^6.29.1",
    "yorkie": "^2.0.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@typescript-eslint/parser": "^8.72.2",
    "@uiw/react-codemirror": "^4.25.12",
    "algoliasearch": "^4.27.0",
    "crelt": "^1.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-select": "^5.10.2",
    "react-split": "^2.0.14"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
