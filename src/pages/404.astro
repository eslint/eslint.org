---
import MainLayout from "../layouts/MainLayout.astro";
import { getSite, links } from "../lib/site";

const site = await getSite(Astro.currentLocale);
const text = site["404_page"];
---

<MainLayout hook="404_page">
	<section class="404 section">
		<div class="content-container grid">
			<div class="span-1-5">
				<h1 class="section-title h0">
					<span class="eyebrow">{text.title}</span>
					{text.subtitle}
				</h1>
				<p class="section-supporting-text">
					{text.description}
				</p>
				<div class="eslint-actions">
					<a href="/" class="c-btn c-btn--primary c-btn--large"
						>{text.actions.back_to_home}</a
					>
					<a href={links.docs} class="c-btn c-btn--secondary c-btn--large"
						>{text.actions.browse_docs}</a
					>
				</div>
			</div>

			<div class="content-container span-7-12">
				<img
					width="480"
					height="366"
					src="/assets/images/404.png"
					alt=""
					loading="lazy"
				/>
			</div>
		</div>
	</section>
</MainLayout>
