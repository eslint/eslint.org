---
/**
 * @fileoverview The frequently asked questions, as an accordion.
 */
import { getSite } from "../lib/site";

const site = await getSite(Astro.currentLocale);
---

<div data-accordion class="c-accordion">
	{
		site.donate_page.faq.items.map(item => (
			<>
				<h3 data-accordion-heading class="c-accordion__heading">
					{item.q}
				</h3>
				<div data-accordion-panel class="c-accordion__panel" set:html={item.a} />
			</>
		))
	}
</div>
