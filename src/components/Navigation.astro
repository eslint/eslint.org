---
/**
 * @fileoverview The main site navigation.
 */
import { getLinkActiveState } from "../lib/helpers";
import { getSite, links, localizeUrl } from "../lib/site";

const site = await getSite(Astro.currentLocale);
const pageUrl = Astro.url.pathname;
const items = site.navigation.map(item => ({
	...item,
	url: localizeUrl(links[item.link], Astro.currentLocale),
}));
---

<nav class="site-nav" aria-label="Main">
	<div class="flexer">
		<a
			href={localizeUrl(links.donate, Astro.currentLocale)}
			class="c-btn c-btn--primary donate-link"
			>{site.donate_page.title}</a
		>
		<button
			class="site-nav-toggle"
			aria-label="Menu"
			id="nav-toggle"
			aria-controls="nav-list"
		>
			<svg width="20" height="20" viewBox="20 20 60 60">
				<path
					id="ham-top"
					d="M30,37 L70,37 Z"
					stroke="currentColor"
				></path>
				<path
					id="ham-middle"
					d="M30,50 L70,50 Z"
					stroke="currentColor"
				></path>
				<path
					id="ham-bottom"
					d="M30,63 L70,63 Z"
					stroke="currentColor"
				></path>
			</svg>
		</button>
	</div>
	<ul id="nav-list" class="nav-list-with-js">
		{items.map(item => <li>
			<a
				href={item.url}
				{...getLinkActiveState(item.url, pageUrl)}
				target={item.target ? "_blank" : undefined}
			>
				{item.text}
			</a>
		</li>)}
	</ul>
	<details class="nav-no-js">
		<summary class="nav-toggle-no-js">
			<svg width="20" height="20" viewBox="20 20 60 60">
				<path
					id="ham-top"
					d="M30,37 L70,37 Z"
					stroke="currentColor"
				></path>
				<path
					id="ham-middle"
					d="M30,50 L70,50 Z"
					stroke="currentColor"
				></path>
				<path
					id="ham-bottom"
					d="M30,63 L70,63 Z"
					stroke="currentColor"
				></path>
			</svg>
		</summary>

		<ul id="nav-list">
			{items.map(item => <li>
				<a
					href={item.url}
					{...getLinkActiveState(item.url, pageUrl)}
					target={item.target ? "_blank" : undefined}
				>
					{item.text}
				</a>
			</li>)}
		</ul>
	</details>
</nav>
