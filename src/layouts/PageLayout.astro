---
/**
 * @fileoverview The layout for simple content pages. It can be used as the
 * `layout` of a Markdown page, in which case the title and description come
 * from the frontmatter of the page.
 */
import BaseLayout from "./BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";

interface Props {
	title?: string;
	description?: string;
	multilingual?: boolean;
	hook?: string;
	frontmatter?: Props;
}

const {
	title,
	description,
	multilingual = false,
	hook = "page",
} = Astro.props.frontmatter ?? Astro.props;
---

<BaseLayout hook={hook} title={title}>
	<Header />

	<main id="main" class="post-main" tabindex="-1">
		<Hero title={title} supportingText={description} />

		<div class="content-container content-container__no-sidebar">
			<slot />
		</div>
	</main>

	<Footer multilingual={multilingual} />
</BaseLayout>
