---
/**
 * @fileoverview The layout for lists of blog posts. The list of posts goes
 * in the default slot and the pagination goes in the "pagination" slot.
 */
import BaseLayout from "./BaseLayout.astro";
import BlogCategories from "../components/BlogCategories.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Search from "../components/Search.astro";
import { getSite } from "../lib/site";

interface Props {
	/** Identifies the type of page: "blog_page" or "category_page". */
	hook: string;

	/** The page title. Defaults to the translated title for the hook. */
	title?: string;
}

const site = await getSite(Astro.currentLocale);
const { hook, title } = Astro.props;
---

<BaseLayout hook={hook} title={title}>
	<Header />

	<main id="main" tabindex="-1">
		<Hero
			title={site.blog_page.title}
			supportingText={site.blog_page.description}
		/>

		<div class="content-container grid">
			<aside class="span-1-3">
				<Search />

				<BlogCategories />
			</aside>

			<div class="span-4-12">
				<slot />
			</div>
			<div class="span-4-12">
				<slot name="pagination" />
			</div>
		</div>
	</main>

	<Footer />
</BaseLayout>
