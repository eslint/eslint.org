---
import Layout from "./Layout.astro";
import Header from "../partials/Header.astro";
import Footer from "../partials/Footer.astro";
import { removeLanguageFromPath } from "~/utils/i18n";

const isPlayground = removeLanguageFromPath(Astro.url.pathname) === "/play";
const { mainClass, multilingual } = Astro.props;
---

<Layout {...Astro.props}>
  <Header />

  <main id="main" class={mainClass} tabindex="-1">
    <slot />
  </main>

    {!isPlayground && <Footer multilingual={multilingual} />}
</Layout>
