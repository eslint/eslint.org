---
/**
 * @fileoverview The layout for the component library.
 */
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import CodeCopy from "../components/CodeCopy.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import { getLinkActiveState } from "../lib/helpers";

interface Props {
	title: string;
}

const { title } = Astro.props;
const items = (await getCollection("library"))
	.sort((a, b) => a.data.title.localeCompare(b.data.title))
	.map(item => ({
		title: item.data.title,
		url: `/component-library/${item.id}/`,
	}));
---

<BaseLayout hook="component_library" title={title}>
	<Header />

	<Hero
		title="ESLint Components"
		supportingText="Components used across this site."
	/>

	<div class="content-container grid">
		<div class="span-1-3">
			<nav class="index">
				<button
					class="index__toggle"
					aria-label="Components"
					id="js-index-toggle"
					hidden
				>
					Components
					<svg width="20" height="20" viewBox="20 20 60 60">
						<path
							id="ham-top"
							d="M30,37 L70,37 Z"
							stroke="currentColor"
						></path>
						<path
							id="ham-middle"
							d="M30,50 L70,50 Z"
							stroke="currentColor"
						></path>
						<path
							id="ham-bottom"
							d="M30,63 L70,63 Z"
							stroke="currentColor"
						></path>
					</svg>
				</button>
				<ul class="index__list" id="js-index-list">
					{items.map(item => <li class="index__item">
						<a
							href={item.url}
							{...getLinkActiveState(
								item.url,
								Astro.url.pathname,
							)}
						>
							{item.title}
						</a>
					</li>)}
				</ul>
			</nav>
		</div>

		<div class="span-4-12">
			<main id="main" tabindex="-1" class="post-main">
				<h1>{title}</h1>
				<slot />
			</main>
		</div>
	</div>

	<Footer />

	<CodeCopy />
</BaseLayout>
